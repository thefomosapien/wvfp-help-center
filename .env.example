# --- Required ---
# Your Anthropic API key from platform.claude.com (NOT a claude.ai subscription).
# Set this in Vercel: Settings -> Environment Variables. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: model override (defaults to claude-haiku-4-5-20251001) ---
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: abuse protection ---
# Comma-separated list of allowed origins. If set, /api/chat rejects requests
# whose Origin/Referer host isn't in this list. Leave unset to allow all.
# ALLOWED_ORIGINS=https://wvfastpitch.org,https://www.wvfastpitch.org

# --- Vercel KV (auto-injected when you create a KV store in the Vercel dashboard) ---
# These power the usage-tracked "Popular Questions" list. If unset, the app still
# works — Popular Questions just falls back to the default order and tracking no-ops.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
